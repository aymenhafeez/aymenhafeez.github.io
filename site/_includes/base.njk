<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title | escape }} - {{ site.title | escape }}</title>
  <meta name="description" content="{{ (description or site.description) | escape }}">
  <meta name="author" content="{{ site.title | escape }}">
  <link rel="canonical" href="{{ page.url | absoluteUrl }}">
  <link rel="stylesheet" href="/assets/style.css">
  <link rel="stylesheet" href="/assets/katex/katex.min.css">
  <link rel="alternate" type="application/rss+xml" title="Blog" href="/rss.xml">
  <link rel="alternate" type="application/rss+xml" title="Notes" href="/notes/rss.xml">
  <link rel="sitemap" href="/sitemap-index.xml">
  <meta property="og:type" content="{{ 'article' if publishDate else 'website' }}">
  <meta property="og:title" content="{{ title | escape }}">
  <meta property="og:description" content="{{ (description or site.description) | escape }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl }}">
  <meta property="og:site_name" content="{{ site.title | escape }}">
  {% if publishDate %}<meta property="article:published_time" content="{{ publishDate | isoDate }}">{% endif %}
  {% if site.analyticsId %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analyticsId }}"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','{{ site.analyticsId }}');</script>
  {% endif %}
</head>
<body>
  <header>
    <nav aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/about/">About</a>
      <a href="/photos/">Photos</a>
    </nav>
    <div class="contact-links">
      <a href="mailto:{{ site.email }}">Email</a>
      <a href="{{ site.github }}">GitHub</a>
    </div>
  </header>
  <main id="main">{{ content | safe }}</main>
</body>
</html>
