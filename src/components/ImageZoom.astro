---
// ImageZoom component - Provides click-to-zoom functionality for images
---

<dialog id="image-zoom-modal" class="image-zoom-dialog">
	<div class="image-zoom-backdrop" data-close-modal></div>
	<div class="image-zoom-content">
		<button class="image-zoom-close" data-close-modal aria-label="Close image">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
		<img src="" alt="" class="image-zoom-img" />
	</div>
</dialog>

<style>
	.image-zoom-dialog {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		max-width: 100vw;
		max-height: 100vh;
		margin: 0;
		padding: 0;
		border: none;
		background: transparent;
		z-index: 9999;
	}

	.image-zoom-dialog::backdrop {
		background: rgba(0, 0, 0, 0.9);
		backdrop-filter: blur(4px);
	}

	.image-zoom-backdrop {
		position: absolute;
		inset: 0;
		cursor: zoom-out;
	}

	.image-zoom-content {
		position: relative;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem;
	}

	.image-zoom-img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		cursor: zoom-out;
		box-shadow: 0 10px 50px rgba(0, 0, 0, 0.5);
	}

	.image-zoom-close {
		position: absolute;
		top: 1rem;
		right: 1rem;
		width: 2.5rem;
		height: 2.5rem;
		border: none;
		background: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(10px);
		border-radius: 50%;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		color: white;
		transition: background 0.2s ease;
		z-index: 10;
	}

	.image-zoom-close:hover {
		background: rgba(255, 255, 255, 0.2);
	}

	.image-zoom-close:focus {
		outline: 2px solid rgba(255, 255, 255, 0.5);
		outline-offset: 2px;
	}

	/* Add zoom cursor to zoomable images */
	:global(img[data-zoomable]) {
		cursor: zoom-in;
	}
</style>

<script>
	function initImageZoom() {
		const modal = document.getElementById("image-zoom-modal") as HTMLDialogElement;
		if (!modal) return;

		const modalImg = modal.querySelector(".image-zoom-img") as HTMLImageElement;
		const closeButtons = modal.querySelectorAll("[data-close-modal]");

		// Add click handlers to all zoomable images
		const zoomableImages = document.querySelectorAll("img[data-zoomable]");
		zoomableImages.forEach((img) => {
			img.addEventListener("click", () => {
				const imgElement = img as HTMLImageElement;
				if (modalImg) {
					modalImg.src = imgElement.src;
					modalImg.alt = imgElement.alt;
					modal.showModal();
				}
			});
		});

		// Close modal when clicking backdrop, close button, or image
		closeButtons.forEach((btn) => {
			btn.addEventListener("click", () => {
				modal.close();
			});
		});

		// Close on Escape key (built-in to dialog element)
		modal.addEventListener("close", () => {
			if (modalImg) {
				modalImg.src = "";
				modalImg.alt = "";
			}
		});
	}

	// Initialize on page load
	document.addEventListener("DOMContentLoaded", initImageZoom);

	// Re-initialize after page navigation (for view transitions)
	document.addEventListener("astro:page-load", initImageZoom);
</script>
