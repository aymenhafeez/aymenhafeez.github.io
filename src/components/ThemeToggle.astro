<theme-toggle class="flex items-center">
	<button
		type="button"
		class="relative flex h-9 w-9 cursor-pointer items-center justify-center rounded-md border bg-[var(--surface)] text-[var(--muted)] transition-colors hover:text-[var(--accent)]"
		aria-label="Colour theme: System. Switch to Light."
		title="System theme"
	>
		<span class="sr-only" data-theme-label>System theme</span>
		<svg
			aria-hidden="true"
			class="h-5 w-5"
			data-theme-icon="system"
			fill="none"
			viewBox="0 0 24 24"
		>
			<rect x="3" y="4" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.5"
			></rect>
			<path d="M8 21h8M12 17v4" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"
			></path>
		</svg>
		<svg
			aria-hidden="true"
			class="hidden h-5 w-5"
			data-theme-icon="light"
			fill="none"
			viewBox="0 0 24 24"
		>
			<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"></circle>
			<path
				d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-width="1.5"></path>
		</svg>
		<svg
			aria-hidden="true"
			class="hidden h-5 w-5"
			data-theme-icon="dark"
			fill="none"
			viewBox="0 0 24 24"
		>
			<path
				d="M20.35 15.42A9 9 0 0 1 8.58 3.65 9 9 0 1 0 20.35 15.42Z"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="1.5"></path>
		</svg>
	</button>
</theme-toggle>

<script>
	const themes = ["system", "light", "dark"] as const;
	type Theme = (typeof themes)[number];
	const nextTheme: Record<Theme, Theme> = { system: "light", light: "dark", dark: "system" };
	const themeName: Record<Theme, string> = { system: "System", light: "Light", dark: "Dark" };

	class ThemeToggle extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector<HTMLButtonElement>("button");
			const label = this.querySelector<HTMLElement>("[data-theme-label]");
			const icons = this.querySelectorAll<SVGElement>("[data-theme-icon]");
			if (!button || !label) return;

			const update = (theme: Theme) => {
				const currentName = themeName[theme];
				const nextName = themeName[nextTheme[theme]];

				label.textContent = `${currentName} theme`;
				button.title = `${currentName} theme`;
				button.setAttribute("aria-label", `Colour theme: ${currentName}. Switch to ${nextName}.`);
				icons.forEach((icon) => {
					icon.classList.toggle("hidden", icon.dataset.themeIcon !== theme);
				});
			};

			const currentTheme = document.documentElement.dataset.themePreference;
			update(themes.includes(currentTheme as Theme) ? (currentTheme as Theme) : "system");

			button.addEventListener("click", () => {
				const preference = document.documentElement.dataset.themePreference;
				const current = themes.includes(preference as Theme) ? (preference as Theme) : "system";
				const next = nextTheme[current];
				window.dispatchEvent(new CustomEvent("theme-preference", { detail: next }));
				update(next);
			});
		}
	}

	if (!customElements.get("theme-toggle")) customElements.define("theme-toggle", ThemeToggle);
</script>
