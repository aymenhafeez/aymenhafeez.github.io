---
import { siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

<footer class="border-t">
	<div
		class="page-shell flex flex-col gap-3 py-8 text-sm text-[var(--muted)] sm:flex-row sm:items-center sm:justify-between"
	>
		<p>&copy; {year} {siteConfig.author}</p>
		<div class="flex gap-5">
			<a class="hover:text-[var(--heading)]" href="/rss.xml">RSS</a>
			<a class="hover:text-[var(--heading)]" href="mailto:aymennh@gmail.com">Email</a>
			<a
				class="hover:text-[var(--heading)]"
				href="https://github.com/aymenhafeez"
				rel="noreferrer"
				target="_blank">GitHub</a
			>
		</div>
	</div>
</footer>
