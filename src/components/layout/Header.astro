---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks, siteConfig } from "@/site.config";

const pathname = Astro.url.pathname;
const isCurrent = (path: string) => (path === "/" ? pathname === "/" : pathname.startsWith(path));
---

<header class="border-b bg-[var(--background)]">
	<div class="page-shell flex min-h-18 flex-wrap items-center justify-between gap-x-6 gap-y-3 py-3">
		<a class="title text-lg no-underline" href="/" aria-label={`${siteConfig.title}, home`}>
			{siteConfig.title}
		</a>
		<div class="flex items-center gap-2 sm:gap-5">
			<nav aria-label="Main navigation">
				<ul class="flex items-center gap-1 sm:gap-2">
					{
						menuLinks
							.filter((link) => link.path !== "/")
							.map((link) => (
								<li>
									<a
										aria-current={isCurrent(link.path) ? "page" : undefined}
										class="rounded-md px-2 py-2 text-sm font-medium text-[var(--muted)] no-underline hover:text-[var(--heading)] aria-[current=page]:text-[var(--heading)] sm:px-3"
										href={link.path}
									>
										{link.title === "Blog" ? "Posts" : link.title}
									</a>
								</li>
							))
					}
				</ul>
			</nav>
			<ThemeToggle />
		</div>
	</div>
</header>
