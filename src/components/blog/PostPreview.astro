---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
};

const { as: Tag = "div", post, withDesc = false } = Astro.props;
---

<FormattedDate class="text-sm text-[var(--muted)] tabular-nums" date={post.data.publishDate} />
<Tag class="min-w-0">
	{post.data.draft && <span class="mr-2 text-sm text-red-600">(Draft)</span>}
	<a
		class="font-medium text-[var(--heading)] decoration-[var(--border)] underline-offset-4 hover:text-[var(--accent)] hover:decoration-[var(--accent)]"
		href={`/posts/${post.id}/`}
	>
		{post.data.title}
	</a>
</Tag>
{
	withDesc && (
		<p class="col-span-full mt-1 text-sm leading-6 text-[var(--muted)] sm:col-start-2">
			{post.data.description}
		</p>
	)
}
