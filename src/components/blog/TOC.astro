---
import type { MarkdownHeading } from "astro";
import { generateToc } from "@/utils/generateToc";
import TOCHeading from "./TOCHeading.astro";

interface Props {
	headings: MarkdownHeading[];
}
const { headings } = Astro.props;
const toc = generateToc(headings);
---

<details class="mb-12 rounded-md border bg-[var(--surface)] px-5 py-4 text-sm">
	<summary class="cursor-pointer font-semibold text-[var(--heading)]">On this page</summary>
	<nav class="mt-3 border-t pt-3 text-[var(--muted)]">
		<ol class="space-y-1.5">{toc.map((heading) => <TOCHeading heading={heading} />)}</ol>
	</nav>
</details>
