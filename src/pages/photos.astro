---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Photo galleries",
	title: "Photos",
};
---
<!-- '<,'>s/bg =[^,]*\?//g -->
<PageLayout meta={meta}>
	<h1 class="title mb-12">Photos</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<ul class="list-inside list-disc" role="list">
      <a class="cactus-link inline-block" href="/photos/iceland/">Iceland</a><br>
      <a class="cactus-link inline-block" href="/photos/bath/">Bath</a><br>
      <a class="cactus-link inline-block" href="/photos/london/">London</a><br>
      <a class="cactus-link inline-block" href="/photos/wales/">Wales</a><br>
      <a class="cactus-link inline-block" href="/photos/newyork/">New York</a><br>
      <a class="cactus-link inline-block" href="/photos/daytoday/">Day to Day</a><br>
		</ul>
	</div>
</PageLayout>
