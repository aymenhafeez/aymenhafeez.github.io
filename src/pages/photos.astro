---
import PageLayout from "@/layouts/Base.astro";

const galleries = [
	{ href: "/photos/iceland/", title: "Iceland", detail: "Pentax K1000 · Fuji Superia xtra 400" },
	{ href: "/photos/bath/", title: "Bath", detail: "Pentax K1000 · ilford HP5 plus 400" },
	{ href: "/photos/london/", title: "London", detail: "Pentax K1000 · ilford HP5 plus 400" },
	{ href: "/photos/wales/", title: "Wales", detail: "Pentax K1000 · kodak portra 400" },
	{ href: "/photos/newyork/", title: "New York", detail: "Pentax K1000 · fuji superia xtra 400" },
	{ href: "/photos/daytoday/", title: "Day to day", detail: "Pentax K1000 · ilford HP5 plus 400" },
];
---

<PageLayout meta={{ description: "", title: "Photos" }}>
	<div class="content-column">
		<!-- <p class="eyebrow mb-4">Photography</p> -->
		<h1 class="title text-4xl sm:text-5xl">Photos</h1>
		<!-- <p class="mt-5 max-w-xl text-lg text-[var(--muted)]"> -->
		<!-- 	A small collection of places, trips, and everyday observations. -->
		<!-- </p> -->
		<ul class="mt-12 divide-y border-y">
			{
				galleries.map((gallery) => (
					<li>
						<a
							class="group flex items-center justify-between gap-6 py-6 no-underline"
							href={gallery.href}
						>
							<span>
								<span class="title block text-xl group-hover:text-[var(--accent)]">
									{gallery.title}
								</span>
								<span class="mt-1 block text-sm text-[var(--muted)]">{gallery.detail}</span>
							</span>
							<span
								class="text-[var(--muted)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--accent)]"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</PageLayout>
