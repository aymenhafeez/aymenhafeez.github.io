---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Bath photos - pentax k1000, ilford HP5 plus 400",
	title: "Bath",
};

const photos = [
	{ src: "/images/bath/bath_1.png", width: 500 },
	{ src: "/images/bath/bath_2.png", width: 500 },
	{ src: "/images/bath/bath_3.png", width: 500 },
	{ src: "/images/bath/bath_4.png", width: 500 },
	{ src: "/images/bath/bath_6.png", width: 500 },
	{ src: "/images/bath/bath_5.png", width: 500 },
];
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">Bath</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p class="mb-8">pentax k1000<br/>ilford HP5 plus 400</p>
		
		{photos.map((photo, index) => (
			<div class="mb-8 text-center">
				<img src={photo.src} alt={`Bath photo ${index + 1}`} style={`max-width: ${photo.width}px; width: 100%; height: auto; margin: 0 auto;`} />
				{index < photos.length - 1 && <p class="my-4">//</p>}
			</div>
		))}
	</div>
</PageLayout>
