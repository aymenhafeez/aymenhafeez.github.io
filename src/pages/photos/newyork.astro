---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "New York photos - pentax k1000, fuji superia xtra 400",
	title: "New York",
};

const photos = [
	{ src: "/images/newyork/ny_1.png", width: 500 },
	{ src: "/images/newyork/ny_2.png", width: 700 },
	{ src: "/images/newyork/ny_3.png", width: 500 },
	{ src: "/images/newyork/ny_4.png", width: 500 },
	{ src: "/images/newyork/ny_5.png", width: 700 },
	{ src: "/images/newyork/ny_6.png", width: 500 },
];
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">New York</h1>
	<div class="prose prose prose-cactus max-w-none">
		<p class="mb-8">pentax k1000<br/>fuji superia xtra 400</p>

		{photos.map((photo, index) => (
			<div class="mb-8 text-center">
				<img src={photo.src} alt={`New York photo ${index + 1}`} style={`max-width: ${photo.width}px; width: 100%; height: auto; margin: 0 auto;`} />
				{index < photos.length - 1 && <p class="my-4">//</p>}
			</div>
		))}
	</div>
</PageLayout>
