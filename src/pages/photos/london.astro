---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "London photos - pentax k1000, ilford HP5 plus 400",
	title: "London",
};

const photos = [
	{ src: "/images/london/london_1.png", width: 700 },
	{ src: "/images/london/london_2.png", width: 700 },
	{ src: "/images/london/london_3.png", width: 500 },
	{ src: "/images/london/london_4.png", width: 700 },
	{ src: "/images/london/london_5.png", width: 700 },
	{ src: "/images/london/london_6.png", width: 500 },
	{ src: "/images/london/london_7.png", width: 500 },
	{ src: "/images/london/london_8.png", width: 500 },
	{ src: "/images/london/london_9.png", width: 500 },
	{ src: "/images/london/london_10.png", width: 500 },
];
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">London</h1>
	<div class="prose prose prose-cactus max-w-none">
		<p class="mb-8">pentax k1000<br/>ilford HP5 plus 400</p>

		{photos.map((photo, index) => (
			<div class="mb-8 text-center">
				<img src={photo.src} alt={`London photo ${index + 1}`} style={`max-width: ${photo.width}px; width: 100%; height: auto; margin: 0 auto;`} />
				{index < photos.length - 1 && <p class="my-4">//</p>}
			</div>
		))}
	</div>
</PageLayout>
